{
  "manifest_version": 3,
  "name": "Email Tracker",
  "version": "1.0.0",
  "description": "Track email opens directly from Gmail.",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*", "http://localhost:5050/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/gmail.js", "content/compose.js", "content/content.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
